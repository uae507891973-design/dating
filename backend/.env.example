# Окружение приложения
APP_NAME=epic-davinci
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# База данных (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://davinci:davinci@localhost:5432/davinci

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (в prod ОБЯЗАТЕЛЬНО задать длинный случайный секрет ≥32 символов)
JWT_SECRET=change-me-in-prod

# Шифрование ПДн в покое (в prod ОБЯЗАТЕЛЬНО длинный секрет ≥32; смена = потеря доступа к данным)
PII_SECRET=dev-pii-secret-change-me

# OTP: в prod otp_debug_log ДОЛЖЕН быть false (иначе код попадёт в логи)
OTP_DEBUG_LOG=false

# Возрастной ценз
MIN_USER_AGE=18
